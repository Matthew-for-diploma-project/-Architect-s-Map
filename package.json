{
  "name": "geokontekst",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "node --env-file=.env tools/serve.mjs",
    "db:check": "node --env-file=.env tools/check-database.mjs",
    "db:migrate": "node --env-file=.env tools/migrate.mjs",
    "db:migrate:test": "node --env-file=.env.test tools/migrate.mjs --test",
    "db:sessions:cleanup": "node --env-file=.env tools/cleanup-sessions.mjs",
    "db:sessions:cleanup:test": "node --env-file=.env.test tools/cleanup-sessions.mjs --test",
    "test": "node --test tests/*.test.mjs",
    "test:browser:account": "node --test tests/browser/account-dialog.test.mjs",
    "test:browser:account-api": "node --test tests/browser/account-api.test.mjs",
    "test:db": "node --env-file=.env.test --test tests/integration/*.test.mjs"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "leaflet": "1.9.4",
    "playwright": "1.62.1"
  }
}
