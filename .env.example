# Local development only. Replace every CHANGE_ME value; do not commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Reserved for auth/CSRF in later iterations; not consumed in P03.
PUBLIC_ORIGIN=http://127.0.0.1:3000

POSTGRES_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
POSTGRES_APP_PASSWORD=CHANGE_ME_APP_PASSWORD
TEST_POSTGRES_ADMIN_PASSWORD=CHANGE_ME_TEST_ADMIN_PASSWORD
TEST_POSTGRES_APP_PASSWORD=CHANGE_ME_TEST_APP_PASSWORD

# The URI password must match POSTGRES_APP_PASSWORD (percent-encode reserved characters).
DATABASE_URL=postgresql://geokontekst:CHANGE_ME_APP_PASSWORD@127.0.0.1:55432/geokontekst
# disable is for this local, loopback-only setup. Remote TLS: verify + optional CA.
DATABASE_SSL=disable
# DATABASE_CA_FILE=/absolute/path/to/root-ca.crt
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
