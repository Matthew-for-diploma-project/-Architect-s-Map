# Separate test configuration. Never point TEST_DATABASE_URL at a working database.
NODE_ENV=test
PUBLIC_ORIGIN=http://127.0.0.1:3000
SESSION_TTL_SECONDS=604800
AUTH_WINDOW_SECONDS=900
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_REGISTER_MAX_ATTEMPTS=5
TRUSTED_PROXY_CIDRS=
# This URL is only compared for isolation; it is never used for test connections.
DATABASE_URL=postgresql://geokontekst:UNUSED_REFERENCE@127.0.0.1:55432/geokontekst
TEST_DATABASE_URL=postgresql://geokontekst_test:CHANGE_ME_TEST_APP_PASSWORD@127.0.0.1:55433/geokontekst_test
DATABASE_SSL=disable
DB_POOL_MAX=2
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
